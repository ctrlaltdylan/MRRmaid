# MRRmaid Configuration
# Copy this file to .env and fill in your API credentials

# Shopify Partner API
# Get these from: https://partners.shopify.com → Settings → Partner API clients
SHOPIFY_PARTNER_TOKEN=your_shopify_partner_api_token
SHOPIFY_ORGANIZATION_ID=your_organization_id
SHOPIFY_API_VERSION=2026-01

# Stripe API
# Get this from: https://dashboard.stripe.com/apikeys
STRIPE_API_KEY=sk_live_your_stripe_secret_key

# Database (optional, defaults to sqlite:///mrrmaid.db)
# DATABASE_URL=sqlite:///mrrmaid.db
